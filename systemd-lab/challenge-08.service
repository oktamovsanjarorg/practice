[Unit]
Description=Telegram Customer Support Bot
# Muammo: Server reboot bo'lganda, bot internet va DNS to'liq ulanmasdan oldin
# ishga tushib ketadi va Telegram API ga ulanolmay darhol crash bo'ladi.
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 /home/sanjar/support_bot.py
Restart=always
RestartSec=3s
User=sanjar

[Install]
WantedBy=multi-user.target
